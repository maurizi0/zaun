# Dedicated agent LAN/VLAN interface and its routed uplink; replace these values.
FIREWALL_MODE=gateway
FIREWALL_ENFORCE=1
GATEWAY_AGENT_INTERFACE=enp2s0
GATEWAY_UPLINK_INTERFACE=enp1s0
GATEWAY_AGENT_NETWORKS=10.20.0.0/24
# Optional IPv4 source NAT. IPv6 requires a routed return path (no NAT66).
GATEWAY_MASQUERADE=1
# ALLOWED_CLIENTS defaults to GATEWAY_AGENT_NETWORKS in gateway mode.
UI_LISTEN=127.0.0.1
UI_PORT=8080
UI_USER=admin
# If omitted, generated once and saved in /var/lib/zaun/ui-password.
# UI_PASSWORD=replace-me
VERIFY_UPSTREAM_TLS=1
DATA_DIR=/var/lib/zaun
PYTHONPATH=/opt/agent-proxy
PYTHONUNBUFFERED=1
